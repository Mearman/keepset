{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr13-transcripts"
  ],
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].sourceClass",
      "nodes[].label",
      "nodes[].sampleRateDirectory",
      "nodes[].clip"
    ],
    "rules": [
      {
        "from": "nodes[].path",
        "op": "move",
        "to": "nodes[].audio"
      }
    ],
    "source": "member-path",
    "target": "audio/v1"
  },
  "description": "The 9,722 non-speech dry recordings at both 16 kHz and 48 kHz, named by source class, sound source, sample rate and clip number. Each is little-endian 16-bit raw audio. The 105 files under reconst/org and the 105 WAV replay files each duplicate the 48 kHz sample 005 of their sound source. The audio remains in openslr-slr13.",
  "domain": "Audio",
  "expectedCounts": {
    "nodes": 19444
  },
  "id": "openslr-slr13-transcripts",
  "licence": {
    "kind": "custom",
    "name": "Research and development use only",
    "url": "https://www.openslr.org/13/"
  },
  "name": "RWCP dry sound recordings",
  "namespace": [
    "openslr",
    "audio"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "pattern": "RWCP/nospeech/drysrc/((?<sourceClass>[a-z][0-9]+)/(?<label>[^/]+)/(?<sampleRateDirectory>16khz|48khz)/(?<clip>[0-9]+)\\.raw)"
      },
      "kind": "tar.gz"
    },
    "parser": {
      "encoding": "utf-8",
      "format": "member-path",
      "idPattern": "RWCP/nospeech/drysrc/((?<sourceClass>[a-z][0-9]+)/(?<label>[^/]+)/(?<sampleRateDirectory>16khz|48khz)/(?<clip>[0-9]+)\\.raw)"
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://openslr.elda.org/resources/13/RWCP.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "audio",
    "sourceClass",
    "label",
    "sampleRateDirectory",
    "clip"
  ]
}
