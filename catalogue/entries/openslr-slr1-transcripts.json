{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr1-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta"
    ],
    "rules": [
      {
        "from": "nodes[].id",
        "op": "copy",
        "to": [
          "nodes[].id",
          "nodes[].sequence"
        ]
      },
      {
        "from": "nodes[].path",
        "op": "move",
        "to": "nodes[].audio"
      }
    ],
    "source": "member-path",
    "target": "speech/v1"
  },
  "description": "The Yesno recordings as the filenames describe them: each identifier and sequence is eight source codes separated by underscores, where 1 means yes and 0 means no. The OpenSLR page describes the language as Hebrew, but the README in the archive says English; neither supplies written transcripts. The audio remains in the distribution listed by openslr-slr1.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 60
  },
  "id": "openslr-slr1-transcripts",
  "licence": {
    "kind": "custom",
    "name": "No formal license but free to use for any purpose.",
    "url": "https://www.openslr.org/1/"
  },
  "name": "Yesno transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "pattern": "waves_yesno/[01](?:_[01]){7}\\.wav"
      },
      "kind": "tar.gz"
    },
    "parser": {
      "encoding": "utf-8",
      "format": "member-path",
      "idPattern": "waves_yesno/([01](?:_[01]){7})\\.wav"
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/1/waves_yesno.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "audio",
    "sequence"
  ]
}
