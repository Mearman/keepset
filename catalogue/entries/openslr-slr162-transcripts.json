{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr162-transcripts"
  ],
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].channels",
      "nodes[].sampleRate",
      "nodes[].byteRate",
      "nodes[].blockAlign",
      "nodes[].bitsPerSample",
      "nodes[].dataBytes",
      "nodes[].duration",
      "nodes[].issue"
    ],
    "rules": [
      {
        "from": "nodes[].path",
        "op": "move",
        "to": "nodes[].audio"
      }
    ],
    "source": "wav-metadata",
    "target": "audio/v1"
  },
  "description": "The audio files as their PCM WAV headers describe them: channel count, sample rate, sample width, data size and duration. The publisher file audio_189.wav has zero audio and invalid PCM format fields; its row retains those fields and identifies the defect. The audio remains in the distribution listed by openslr-slr162.",
  "domain": "Speech / Audio Forensics / Signal Processing",
  "expectedCounts": {
    "nodes": 190
  },
  "id": "openslr-slr162-transcripts",
  "licence": {
    "kind": "custom",
    "name": "MIT License",
    "url": "https://www.openslr.org/162/"
  },
  "name": "Rasheed Mudasiru recording metadata",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "pattern": "audio-for-forensic-and-multi-speaker-separation/audio_[0-9]+\\.wav"
      },
      "kind": "zip"
    },
    "parser": {
      "encoding": "utf-8",
      "format": "wav-metadata",
      "idPattern": "audio-for-forensic-and-multi-speaker-separation/(audio_[0-9]+)\\.wav"
    },
    "source": 0,
    "status": "fetchable",
    "stream": true
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/162/audio-for-forensic-and-multi-speaker-separation.zip"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "audio",
    "duration",
    "channels",
    "sampleRate",
    "bitsPerSample",
    "issue"
  ]
}
