{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr43-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "file": "crosswalks/speech-v1/id-text.json"
  },
  "description": "The transcripts of High quality TTS data for Nepali: one instance per transcript table, each record being an utterance with its identifier and text. It carries none of the audio, which the download list of openslr-slr43 gives.",
  "domain": "Speech",
  "expectedCounts": {
    "instances": 1
  },
  "id": "openslr-slr43-transcripts",
  "licence": {
    "kind": "custom",
    "name": "Attribution-ShareAlike 4.0 (CC BY-SA 4.0)",
    "url": "https://www.openslr.org/43/"
  },
  "name": "High quality TTS data for Nepali transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "kind": "zip",
      "members": {
        "pattern": "[^/]+/line_index\\.tsv"
      }
    },
    "parser": {
      "columns": [
        "text"
      ],
      "delimiter": "tab",
      "encoding": "utf-8",
      "format": "csv-table",
      "headerNames": [
        "file_id",
        "text"
      ],
      "idColumn": "file_id",
      "numericColumns": [],
      "skipLines": 0,
      "unquoted": true
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-30",
      "status": "live",
      "url": "https://www.openslr.org/resources/43/ne_np_female.zip"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "text"
  ]
}
