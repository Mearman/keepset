{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr82-cn2-audio"
  ],
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].speaker",
      "nodes[].label",
      "nodes[].session",
      "nodes[].clip"
    ],
    "rules": [
      {
        "from": "nodes[].path",
        "op": "move",
        "to": "nodes[].audio"
      }
    ],
    "source": "member-path",
    "target": "audio/v1"
  },
  "description": "CN-Celeb2 recordings as their archive paths identify them, retaining the speaker, genre, session and clip codes in each path. The entry describes the recordings and carries no audio.",
  "domain": "Speech",
  "expectedCounts": {
    "instances": 1
  },
  "id": "openslr-slr82-cn2-audio",
  "licence": {
    "kind": "custom",
    "name": "Attribution-ShareAlike 4.0 International",
    "url": "https://www.openslr.org/82/"
  },
  "name": "CN-Celeb2 recording annotations",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "files": [
      {
        "archive": {
          "files": {
            "extensions": [
              ".flac"
            ]
          },
          "kind": "tar.gz"
        },
        "path": "cn-celeb2",
        "source": [
          0,
          1,
          2
        ]
      }
    ],
    "parser": {
      "encoding": "utf-8",
      "format": "member-path",
      "idPattern": "CN-Celeb2_flac/data/((?<speaker>id[0-9]+)/(?<label>[a-z_]+)-(?<session>[0-9]+)-(?<clip>[0-9]+))\\.flac"
    },
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://openslr.elda.org/resources/82/cn-celeb2_v2.tar.gzaa"
    },
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://openslr.elda.org/resources/82/cn-celeb2_v2.tar.gzab"
    },
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://openslr.elda.org/resources/82/cn-celeb2_v2.tar.gzac"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "speaker",
    "label",
    "session",
    "clip",
    "audio"
  ]
}
