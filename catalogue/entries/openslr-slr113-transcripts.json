{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr113-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].text",
      "nodes[].start",
      "nodes[].end"
    ],
    "source": "textgrid",
    "target": "speech/v1"
  },
  "description": "The transcripts of SEOUL CORPUS as its Praat TextGrid label files give them: each record is an interval of the utterance orthography tier with its identifier (the file, the tier's position and the interval's position), text, and start and end in seconds. Intervals with no text are left out, and the corpus's own markers for noise, the interviewer and private information are kept as the files write them. It carries none of the audio, which the download list of openslr-slr113 gives.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 128313
  },
  "id": "openslr-slr113-transcripts",
  "licence": {
    "kind": "custom",
    "name": "Attribution-NonCommercial 2.0 Generic (CC BY-NC 2.0)",
    "url": "https://www.openslr.org/113/"
  },
  "name": "SEOUL CORPUS transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "extensions": [
          ".zip"
        ]
      },
      "inner": {
        "files": {
          "extensions": [
            ".TextGrid"
          ]
        },
        "kind": "zip"
      },
      "kind": "tar.gz"
    },
    "parser": {
      "encoding": "utf-8",
      "format": "textgrid",
      "idPattern": "[^/]+\\.zip/(.+)\\.TextGrid",
      "tier": "utt.ortho."
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://www.openslr.org/resources/113/label.tgz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "text",
    "start",
    "end"
  ]
}
