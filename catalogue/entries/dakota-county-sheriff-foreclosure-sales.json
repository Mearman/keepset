{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "sheriff-foreclosure-sales"
  ],
  "category": "tasks/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id"
    ],
    "rules": [
      {
        "from": "nodes[].SaleDate",
        "op": "move",
        "to": "nodes[].deadline"
      },
      {
        "from": "nodes[].geometry_latitude",
        "op": "move",
        "to": "nodes[].lat"
      },
      {
        "from": "nodes[].geometry_longitude",
        "op": "move",
        "to": "nodes[].lon"
      },
      {
        "from": "nodes[].SaleAmount",
        "op": "move",
        "to": "nodes[].prize"
      },
      {
        "from": "nodes[].CITYNAME",
        "op": "move",
        "to": "nodes[].territory"
      }
    ],
    "source": "geojson",
    "target": "tasks/v1"
  },
  "description": "Sheriff foreclosure sales in Dakota County, Minnesota, with sale amounts and dates for 2025.",
  "domain": "Case records",
