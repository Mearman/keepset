    "rules": [
      {
        "from": "nodes[].category",
        "op": "move",
        "to": "nodes[].label"
      },
      {
        "from": "nodes[].fold",
        "op": "move",
        "to": "nodes[].split"
      }
    ],
    "source": "csv-table",
    "target": "audio/v1"
  },
  "description": "A labelled collection of short environmental audio recordings (animals, natural soundscapes, non-speech human sounds, domestic and urban noises) for benchmarking environmental sound classification, as the clips its annotation table lists: one record per recording, named by its file, with its sound class (category and its numeric target), the cross-validation fold it belongs to (the split), whether it is in the ESC-10 subset, and the Freesound clip it was cut from (src_file) with the letter that tells fragments of one Freesound clip apart (take). The dataset as a whole is under CC BY-NC 3.0, and the ESC-10 subset is also licensed CC BY 3.0. It carries none of the audio, which is the WAV files in the audio directory of the same repository, downloadable as one archive.",
  "domain": "Audio",
  "expectedCounts": {
    "nodes": 2000
  },
