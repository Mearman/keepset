{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].corrected",
      "nodes[].speaker",
      "nodes[].point",
      "nodes[].microphone",
      "nodes[].speed",
      "nodes[].utterance"
    ],
    "rules": [
      {
        "from": "nodes[].id",
        "op": "copy",
        "to": [
          "nodes[].id",
          "nodes[].audio"
        ]
      }
    ],
    "source": "csv-table",
    "target": "speech/v1"
  },
  "description": "The HI-MIA development filenames as the publisher mapping describes them: original and corrected recording names, with speaker, recording point, microphone, speaking speed (S slow, N normal, F fast) and utterance code decoded from the original name. The source describes the wake word; the mapping supplies no verified transcripts. The audio remains in the distribution listed by openslr-slr85.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 164640
  },
  "id": "openslr-slr85-dev-mapping",
  "licence": {
    "kind": "custom",
    "name": "Apache License v.2.0",
    "url": "https://www.openslr.org/85/"
  },
  "name": "HI-MIA development recording metadata",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {
    "split": "dev"
  },
  "recipe": {
    "archive": {
      "kind": "tar.gz",
      "member": {
        "path": "dev_filename_mapping.txt"
      }
    },
    "parser": {
      "columns": [
        "corrected"
      ],
      "delimiter": "space",
      "encoding": "utf-8",
      "format": "csv-table",
      "headerNames": [
        "original",
        "corrected"
      ],
      "idColumn": "original",
      "idPattern": "(?<speaker>SV\\d+)_(?<point>\\d+)_(?<microphone>\\d+)_(?<speed>[SNF])(?<utterance>\\d+)\\.wav",
      "numericColumns": [],
      "skipLines": 0,
      "unquoted": true
    },
    "source": 0,
    "status": "fetchable",
    "stream": true
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/85/filename_mapping.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "audio",
    "corrected",
    "speaker",
    "point",
    "microphone",
    "speed",
    "utterance"
  ]
}
