{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].rir_id",
      "nodes[].room_id",
      "nodes[].room_info",
      "nodes[].room_length",
      "nodes[].room_width",
      "nodes[].room_height",
      "nodes[].receiver_x",
      "nodes[].receiver_y",
      "nodes[].receiver_z",
      "nodes[].absorption_coefficient"
    ],
    "source": "simulated-rir",
    "target": "audio/v1"
  },
  "description": "The simulated room impulse responses as the source lists describe them, in separate 8 kHz and 16 kHz instances. Each response carries its source response and room identifiers, room dimensions, receiver coordinates and absorption coefficient, with the original room values retained as text. It carries none of the audio, which openslr-slr26 lists.",
  "domain": "Audio",
  "expectedCounts": {
    "instances": 2
  },
  "id": "openslr-slr26-clips",
  "licence": {
    "kind": "custom",
    "name": "Apache 2.0",
    "url": "https://www.openslr.org/26/"
  },
  "name": "Simulated Room Impulse Response Database (annotations)",
  "namespace": [
    "openslr",
    "audio"
  ],
  "properties": {},
  "recipe": {
    "files": [
      {
        "archive": {
          "files": {
            "pattern": "simulated_rirs_(?:8k|16k)/(?:smallroom|mediumroom|largeroom)/(?:rir_list|room_info)"
          },
          "kind": "zip"
        },
        "path": "8k",
        "source": 0
      },
      {
        "archive": {
          "files": {
            "pattern": "simulated_rirs_(?:8k|16k)/(?:smallroom|mediumroom|largeroom)/(?:rir_list|room_info)"
          },
          "kind": "zip"
        },
        "path": "16k",
        "source": 1
      }
    ],
    "parser": {
      "encoding": "utf-8",
      "format": "simulated-rir"
    },
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/26/sim_rir_8k.zip"
    },
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/26/sim_rir_16k.zip"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "rir_id",
    "room_id",
    "room_info",
    "room_length",
    "room_width",
    "room_height",
    "receiver_x",
    "receiver_y",
    "receiver_z",
    "absorption_coefficient"
  ]
