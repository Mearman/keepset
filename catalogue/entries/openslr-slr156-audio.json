{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr156-audio"
  ],
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "nodes[].noise",
      "meta",
      "nodes[].id",
      "nodes[].speakerCode"
    ],
    "rules": [
      {
        "from": "nodes[].env",
        "op": "move",
        "to": "nodes[].environment"
      },
      {
        "from": "nodes[].stat",
        "op": "move",
        "to": "nodes[].physicalState"
      }
    ],
    "source": "csv-table",
    "target": "audio/v1"
  },
  "description": "Recording environment, physical state and noise as recorded for each SMIIP-TV utterance, in the source Chinese. The speakerCode is the speaker number in the utterance ID; the corresponding speaker ID is prefixed with spk. The entry carries annotations and no recordings.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 325161
  },
  "id": "openslr-slr156-audio",
  "licence": {
    "kind": "custom",
    "name": "Attribution-ShareAlike 3.0 Unported (CC BY-SA 3.0 US)",
    "url": "https://www.openslr.org/156/"
  },
  "name": "SMIIP-TV utterance conditions",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "kind": "tar.gz",
      "member": {
        "path": "release_v1/meta_info/utt2info.zh"
      }
    },
    "parser": {
      "delimiter": "comma-space",
      "encoding": "utf-8",
      "format": "csv-table",
      "idColumn": "utt_id",
      "idPattern": "(?<speakerCode>[0-9]{4})_.+",
      "numericColumns": [],
      "skipLines": 0,
      "unquoted": true
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://openslr.elda.org/resources/156/SMIIP-TV_v2.0.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "speakerCode",
    "environment",
    "physicalState",
    "noise"
  ]
}
