{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr145-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].text",
      "nodes[].duration"
    ],
    "source": "json-table",
    "target": "speech/v1"
  },
  "description": "The utterances of LibriSpeech-PC as its manifests list them: one instance per manifest, each record being an utterance with its audio file, text and duration. It carries none of the audio, which the download list of openslr-slr145 gives.",
  "domain": "Text",
  "expectedCounts": {
    "instances": 7
  },
  "id": "openslr-slr145-transcripts",
  "licence": {
    "kind": "custom",
    "name": "CC BY 4.0",
    "url": "https://www.openslr.org/145/"
  },
  "name": "LibriSpeech-PC transcripts",
  "namespace": [
    "openslr",
    "text"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "kind": "tar.gz",
      "members": {
        "pattern": ".*\\.json"
      }
    },
    "parser": {
      "encoding": "utf-8",
      "fields": [
        "text",
        "duration"
      ],
      "format": "json-table",
      "idField": "audio_filepath",
      "layout": "lines"
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-30",
      "status": "live",
      "url": "https://www.openslr.org/resources/145/manifests.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "text",
    "duration"
  ]
}
