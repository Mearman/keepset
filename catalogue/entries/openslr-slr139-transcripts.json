{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr139-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "nodes[].duration",
      "meta",
      "nodes[].id",
      "nodes[].filename"
    ],
    "rules": [
      {
        "from": "nodes[].path",
        "op": "move",
        "to": "nodes[].audio"
      },
      {
        "from": "nodes[].spk_id",
        "op": "move",
        "to": "nodes[].speaker"
      },
      {
        "from": "nodes[].spk_gender",
        "op": "move",
        "to": "nodes[].gender"
      }
    ],
    "source": "json-table",
    "target": "speech/v1"
  },
  "description": "The Audiocite.net French speech recordings as its metadata lists them: one record per audio file with its path, duration, speaker and gender. The source cautions that gender was inferred and is not ground truth. Transcript fields are empty. It carries none of the audio, which openslr-slr139 lists.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 28485
  },
  "id": "openslr-slr139-transcripts",
  "licence": {
    "kind": "custom",
    "name": "Depends on each audio file (CC BY (Public domain) or CC BY SA (Share alike) or CC BY ND (No modification) or CC BY NC (No commercial use) or combination of the above)",
    "url": "https://www.openslr.org/139/"
  },
  "name": "Audiocite.net recording metadata",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "kind": "zip",
      "member": {
        "path": "metadata/all_files.json"
      }
    },
    "parser": {
      "encoding": "utf-8",
      "fields": [
        "path",
        "duration",
        "spk_id",
        "spk_gender"
      ],
      "format": "json-table",
      "layout": "nested",
      "levels": [
        "filename"
      ],
      "numericFields": [
        "duration"
      ]
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/139/audiocite.net_0.zip"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "audio",
    "duration",
    "speaker",
    "gender"
  ]
}
