      "doi": "10.1002/net.22188",
      "text": "M. Gamst, D. Pisinger (2024). Decision support for the technician routing and scheduling problem. Networks 83(1), 169-196."
    }
  ],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].earliest",
      "nodes[].priority",
      "nodes[].penalty",
      "nodes[].modified",
      "nodes[].cancelled"
    ],
    "rules": [
      {
        "from": "nodes[].latest",
        "op": "move",
        "to": "nodes[].deadline"
      },
      {
        "factor": 60,
        "from": "nodes[].durationMinutes",
        "op": "scale",
        "to": "nodes[].duration"
      },
      {
        "from": "nodes[].created",
        "op": "move",
        "to": "nodes[].opened"
      },
      {
        "from": "nodes[].skills",
        "op": "move",
        "to": "nodes[].skill"
      }
    ],
    "source": "tdc",
    "target": "tasks/v1"
  },
  "description": "Instance sets and raw results for the technician routing and scheduling problem of Gamst and Pisinger, including the instances of Mathlouthi, Gendreau and Potvin and a further technician dispatch set called TDCData.",
