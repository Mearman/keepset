{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr117-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].gender",
      "nodes[].duration"
    ],
    "rules": [
      {
        "from": "nodes[].sentence",
        "op": "move",
        "to": "nodes[].text"
      },
      {
        "from": "nodes[].speaker_id",
        "op": "move",
        "to": "nodes[].speaker"
      },
      {
        "from": "nodes[].filename",
        "op": "move",
        "to": "nodes[].audio"
      },
      {
        "from": "nodes[].status",
        "op": "move",
        "to": "nodes[].split"
      }
    ],
    "source": "csv-table",
    "target": "speech/v1"
  },
  "description": "The transcripts of Samrómur Children 21.09: each record is an utterance with its text, speaker, gender, audio file, split and duration. It carries none of the audio, which the download list of openslr-slr117 gives.",
  "domain": "Speech",
  "expectedCounts": {
    "instances": 1
  },
  "id": "openslr-slr117-transcripts",
  "licence": {
    "kind": "custom",
    "name": "CC by 4.0",
    "url": "https://www.openslr.org/117/"
  },
  "name": "Samrómur Children 21.09 transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "kind": "zip",
      "members": {
        "pattern": "samromur_children_21\\.09/metadata\\.tsv"
      }
    },
    "parser": {
      "columns": [
        "sentence",
        "speaker_id",
        "gender",
        "filename",
        "status",
        "duration"
      ],
      "delimiter": "tab",
      "encoding": "utf-8",
      "format": "csv-table",
      "idColumn": "id",
      "nullValues": [
        "NAN"
      ],
      "numericColumns": [
        {
          "column": "duration",
          "factor": 1
        }
      ],
      "skipLines": 0
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://www.openslr.org/resources/117/samromur_children_21.09.zip"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "text",
    "speaker",
    "gender",
    "audio",
    "split",
    "duration"
  ]
}
