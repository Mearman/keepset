{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr119-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].text",
      "nodes[].start",
      "nodes[].end"
    ],
    "source": "textgrid",
    "target": "speech/v1"
  },
  "description": "The transcripts of AliMeeting as the near-field (headset) Praat TextGrid files give them: one instance for each of the training, evaluation and test sets, whose records are the intervals of every participant's transcript tier, each with its identifier (the recording and participant, the tier's position in the file and the interval's position in the tier), its text, and its start and end in seconds. Intervals with no text are left out. The far-field TextGrid files and all of the audio are not read: the audio is in the distribution the download list of openslr-slr119 gives.",
  "domain": "Speech",
  "expectedCounts": {
    "instances": 3
  },
  "id": "openslr-slr119-transcripts",
  "licence": {
    "kind": "custom",
    "name": "CC BY-SA 4.0",
    "url": "https://www.openslr.org/119/"
  },
  "name": "AliMeeting transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "files": [
      {
        "archive": {
          "files": {
            "pattern": "Train_Ali_near/textgrid_dir/[^/]+\\.TextGrid"
          },
          "kind": "tar.gz"
        },
        "path": "Train_Ali_near",
        "source": 0
      },
      {
        "archive": {
          "files": {
            "pattern": "Eval_Ali/Eval_Ali_near/textgrid_dir/[^/]+\\.TextGrid"
          },
          "kind": "tar.gz"
        },
        "path": "Eval_Ali",
        "source": 1
      },
      {
        "archive": {
          "files": {
            "pattern": "Test_Ali/Test_Ali_near/textgrid_dir/[^/]+\\.TextGrid"
          },
          "kind": "tar.gz"
        },
        "path": "Test_Ali",
        "source": 2
      }
    ],
    "parser": {
      "encoding": "utf-8",
      "format": "textgrid",
      "idPattern": "(?:.*/)?([^/]+)\\.TextGrid"
    },
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://speech-lab-share-data.oss-cn-shanghai.aliyuncs.com/AliMeeting/openlr/Train_Ali_near.tar.gz"
    },
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://speech-lab-share-data.oss-cn-shanghai.aliyuncs.com/AliMeeting/openlr/Eval_Ali.tar.gz"
    },
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://speech-lab-share-data.oss-cn-shanghai.aliyuncs.com/AliMeeting/openlr/Test_Ali.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "text"
  ]
}
