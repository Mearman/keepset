{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr123-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].span",
      "nodes[].speaker",
      "nodes[].gender_dialect",
      "nodes[].text"
    ],
    "source": "csv-table",
    "target": "speech/v1"
  },
  "description": "The transcripts of MAGICDATA Mandarin Chinese Conversational Speech Corpus: one instance per conversation, each record being an utterance with its line number in the conversation as identifier, the span of the conversation it covers (start and end in seconds, as the source writes them), its speaker, the speaker's gender and dialect as one field, and its text. It carries none of the audio, which the download list of openslr-slr123 gives.",
  "domain": "Speech",
  "expectedCounts": {
    "instances": 351
  },
  "id": "openslr-slr123-transcripts",
  "licence": {
    "kind": "custom",
    "name": "Attribution-NonCommercial-NoDerivatives 4.0 International Public License (CC BY-NC-ND 4.0)",
    "url": "https://www.openslr.org/123/"
  },
  "name": "MAGICDATA Mandarin Chinese Conversational Speech Corpus transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "kind": "tar.gz",
      "members": {
        "pattern": "(?:\\./)?MDT2021S003/TXT/(?:.*/)?[^/]+\\.txt"
      }
    },
    "parser": {
      "columns": [
        "span",
        "speaker",
        "gender_dialect",
        "text"
      ],
      "delimiter": "tab",
      "encoding": "utf-8",
      "format": "csv-table",
      "headerNames": [
        "span",
        "speaker",
        "gender_dialect",
        "text"
      ],
      "idColumn": null,
      "numericColumns": [],
      "skipLines": 0,
      "unquoted": true
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://www.openslr.org/resources/123/MagicData-RAMC.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "span",
    "speaker",
    "gender_dialect",
    "text"
  ]
}
