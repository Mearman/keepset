{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr107-transcripts"
  ],
  "category": "speech/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].text",
      "nodes[].tier",
      "nodes[].start",
      "nodes[].end"
    ],
    "source": "eaf",
    "target": "speech/v1"
  },
  "description": "The transcripts of the Totonac conversations as their ELAN files give them: each record is an annotation, named by the recording and the annotation's identifier in its file, with its text, the tier it is on (a speaker's, or a translation) and its start and end in milliseconds, null for an annotation that refers to another and has no times of its own. It carries none of the audio, which the download list of openslr-slr107 gives.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 12228
  },
  "id": "openslr-slr107-transcripts",
  "licence": {
    "kind": "custom",
    "name": "Attribution-NonCommercial-ShareAlike 3.0 Unported (CC BY-NC-SA 3.0)",
    "url": "https://www.openslr.org/107/"
  },
  "name": "Totonac Resources transcripts",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "pattern": "Conversaciones/(?:[^/]+/)*[^/]+\\.eaf"
      },
      "kind": "tar.gz"
    },
    "parser": {
      "encoding": "utf-8",
      "format": "eaf",
      "idPattern": "Conversaciones/(?:[^/]+/)*([^/]+)\\.eaf"
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-31",
