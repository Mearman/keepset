{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "aliases": [
    "slr81-transcripts"
  ],
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].label"
    ],
    "rules": [
      {
        "from": "nodes[].path",
        "op": "move",
        "to": "nodes[].audio"
      }
    ],
    "source": "member-path",
    "target": "audio/v1"
  },
  "description": "The 25 one-second audio clips as their filenames and OpenSLR description identify them. The label is the source prefix: bmaher, joliver, lmiserables, piano or simons. The page summary says 20 clips, but its detailed description and the archive contain 25. The audio remains in the distribution listed by openslr-slr81.",
  "domain": "Speech",
  "expectedCounts": {
    "nodes": 25
  },
  "id": "openslr-slr81-transcripts",
  "licence": {
    "kind": "custom",
    "name": "CC BY 4.0",
    "url": "https://www.openslr.org/81/"
  },
  "name": "Small Audio Clips annotations",
  "namespace": [
    "openslr",
    "speech"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "pattern": "samples/(?:bmaher|joliver|lmiserables|piano|simons)[0-4]\\.wav"
      },
      "kind": "tar.gz"
    },
    "parser": {
      "encoding": "utf-8",
      "format": "member-path",
      "idPattern": "samples/((?<label>bmaher|joliver|lmiserables|piano|simons)[0-4])\\.wav"
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-11-06",
      "status": "live",
      "url": "https://www.openslr.org/resources/81/samples.tar.gz"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "label",
    "audio"
  ]
}
