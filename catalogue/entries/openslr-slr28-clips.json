{
  "$schema": "https://cdn.jsdelivr.net/npm/keepset/schemas/entry.schema.json",
  "category": "audio/v1",
  "citations": [],
  "crosswalk": {
    "keep": [
      "meta",
      "nodes[].id",
      "nodes[].rir_id",
      "nodes[].room_id",
      "nodes[].noise_id",
      "nodes[].bg_fg_type",
      "nodes[].room_linkage"
    ],
    "rules": [
      {
        "from": "nodes[].noise_type",
        "op": "move",
        "to": "nodes[].label"
      }
    ],
    "source": "option-list",
    "target": "audio/v1"
  },
  "description": "The room impulse responses and noises of the Room Impulse Response and Noise Database as the lists in its download describe them: each record is a recording named by its path in the download, with the identifiers the lists give it (rir_id, room_id, noise_id and room_linkage), the kind of noise as its label and whether a point-source noise is background or foreground (bg_fg_type), null for what a list does not give. It carries none of the audio, which the download list of openslr-slr28 gives.",
  "domain": "Audio",
  "expectedCounts": {
    "nodes": 61260
  },
  "id": "openslr-slr28-clips",
  "licence": {
    "kind": "custom",
    "name": "Apache 2.0",
    "url": "https://www.openslr.org/28/"
  },
  "name": "Room Impulse Response and Noise Database (annotations)",
  "namespace": [
    "openslr",
    "audio"
  ],
  "properties": {},
  "recipe": {
    "archive": {
      "files": {
        "pattern": "RIRS_NOISES/(?:[^/]+/)*(?:rir|noise)_list"
      },
      "kind": "zip"
    },
    "parser": {
      "encoding": "utf-8",
      "fields": [
        "rir_id",
        "room_id",
        "noise_id",
        "noise_type",
        "bg_fg_type",
        "room_linkage"
      ],
      "format": "option-list"
    },
    "source": 0,
    "status": "fetchable"
  },
  "sources": [
    {
      "retrieved": "2026-10-31",
      "status": "live",
      "url": "https://www.openslr.org/resources/28/rirs_noises.zip"
    }
  ],
  "subjects": [
    "speech-and-language-processing"
  ],
  "tags": [
    "label",
    "rir_id",
    "room_id",
    "noise_id",
    "bg_fg_type",
    "room_linkage"
  ]
}
