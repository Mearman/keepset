{
  "name": "keepset",
  "description": "Library, CLI and statically generated catalogue for dataset fetch-and-normalise recipes",
  "version": "0.58.1",
  "bin": {
    "keepset": "./dist-cli/keepset.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.19",
    "@vanilla-extract/css": "1.21.3",
    "crossmap": "0.2.0",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "unbzip2-stream": "1.4.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@exadev/eslint-config": "3.1.0",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unbzip2-stream": "1.4.3",
    "@vanilla-extract/esbuild-plugin": "2.3.22",
    "@vitest/coverage-v8": "5.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "events": "3.3.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "publint": "0.3.25",
    "readable-stream": "2.3.8",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/fetch-dataset.d.ts",
      "import": "./dist/node/fetch-dataset.js"
    },
    "./browser": {
      "types": "./dist/browser/entry.d.ts",
      "import": "./dist/browser/entry.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json"
  },
  "files": [
    "dist",
    "dist-cli",
    "schemas"
  ],
  "keywords": [
    "catalogue",
    "data",
    "dataset",
    "download",
    "fetch",
    "graph",
    "normalise"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mearman/keepset.git"
  },
  "scripts": {
    "archive:check": "tsx scripts/archive-sources.ts --check",
    "build": "pnpm run catalogue && tsdown && tsx scripts/generate-json-schema.ts",
    "catalogue": "tsx scripts/build-catalogue.ts",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "lint:check": "eslint . --cache --max-warnings 0",
    "prepare": "husky",
    "prepublishOnly": "pnpm run lint:check && pnpm run build && pnpm run typecheck && pnpm run test && publint && attw --pack --profile esm-only",
    "seed:audit:licences": "tsx scripts/seed/licence-audit.ts",
    "seed:check": "pnpm run seed:check:graph && pnpm run seed:check:or",
    "seed:check:graph": "tsx scripts/seed/import-phd-catalogue.ts --pipeline scripts/seed/sources/pipeline-catalog.json --graphbox scripts/seed/sources/graphbox-catalog.json --check",
    "seed:check:or": "tsx scripts/seed/import-or-survey.ts --check",
    "seed:import:graph": "tsx scripts/seed/import-phd-catalogue.ts",
    "seed:import:or": "tsx scripts/seed/import-or-survey.ts",
    "site": "tsx site/build.ts",
    "sources:check": "tsx scripts/check-sources.ts",
    "test": "vitest run",
    "test:e2e": "pnpm run build && pnpm run site && playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.site.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.e2e.json"
  },
  "sideEffects": [
    "**/*.css.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.ts"
}
